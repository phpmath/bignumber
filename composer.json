{
    "name": "phpmath/bignumber",
    "type": "library",
    "description": "A PHP library to work with big numbers.",
    "keywords": [
        "phpmath",
        "bignumber",
        "bcmath",
        "math",
        "php8"
    ],
    "homepage": "https://github.com/phpmath/bignumber",
    "license": "MIT",
    "authors": [
        {
            "name": "Walter Tamboer",
            "homepage": "https://waltertamboer.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "phpmath/coding-standard": "^2.0",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "PHPMath\\BigNumber\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPMath\\BigNumber\\Tests\\": "tests/unit"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-html build/phpunit-coverage/"
        ],
        "check-style": "vendor/bin/phpcs",
        "fix-style": "vendor/bin/phpcbf",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "optimize-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
